{
  "name": "apk-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "APK Builder — конвертер кода в APK, декомпилятор, XAPK→APK и сборщик Android-приложений",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "engine:test": "tsx tools/test-engine.ts",
    "apk:self": "tsx tools/make-apk.ts",
    "desktop:assets": "tsx tools/embed-assets.ts",
    "desktop:exe": "bun build --compile --target=bun-windows-x64 desktop/server.ts --outfile release/APK-Builder-1.0.0.exe",
    "release": "npm run build && npm run apk:self && npm run build && npm run desktop:assets && npm run desktop:exe",
    "verify:apk": "python3 tools/verify-signature.py release/APK-Builder-1.0.0.apk",
    "ssr:test": "tsx tools/smoke-ssr.tsx",
    "smoke:dom": "tsx tools/smoke-dom.tsx"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@oven/bun-windows-x64": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bun": "^1.4.5",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
